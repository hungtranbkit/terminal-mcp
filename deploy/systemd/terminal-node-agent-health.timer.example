# Runs the node agent health/capacity check. See the .service for why.
[Unit]
Description=Run terminal-mcp node agent health check every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
# The check is cheap (reads cgroup files and the journal), but do not let
# a backlog of missed runs stampede after a resume.
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
