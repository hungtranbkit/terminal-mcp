[Unit]
Description=Terminal MCP loopback Streamable HTTP server
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/dell/workspace/terminal-mcp
Environment=TERMINAL_MCP_CONFIG=/home/dell/workspace/terminal-mcp/config.yaml
# Per-node shared secrets for config.yaml's nodes.remote[].token_env
# entries -- mode 600, never inline here. The leading "-" means "load if
# present, skip silently otherwise" -- without it, systemd refuses to
# even START this unit on a fresh single-node deployment that has no
# remote nodes (and therefore no reason to have created this file) yet.
EnvironmentFile=-%h/.config/terminal-mcp/node-agent-tokens.env
ExecStart=/home/dell/workspace/terminal-mcp/.venv/bin/terminal-mcp-http
Restart=on-failure
RestartSec=3

# --- P1 hardening item #12: resource limits + sandboxing ------------------
# Conservative on purpose, and live-verified (real tmux sessions, real
# sqlite writes, full dashboard/health smoke test, restart) against a real
# deployment before being adopted here. PrivateTmp is deliberately NOT
# set: this service needs real access to the user's actual tmux server
# socket (typically /tmp/tmux-$UID/default) to do its job at all --
# PrivateTmp would put it in its own private /tmp, cut off from that
# socket, and silently break every tmux observation/control path.
#
# Resource ceilings: generous headroom above this service's real steady-
# state usage (observed ~60MB RSS, a handful of threads) -- meant to catch
# a genuine leak/runaway, not constrain normal operation.
MemoryMax=512M
TasksMax=256
CPUQuota=200%

# Filesystem: /usr, /boot, /etc read-only (ProtectSystem=full leaves /tmp
# and /var alone, unlike =strict); the entire home tree read-only
# (ProtectHome=read-only) except this service's own sqlite state
# directory, explicitly re-opened for writes. /tmp (and therefore the
# tmux socket) is untouched by either setting. Both are pure mount-
# namespace operations -- no capability drop required, confirmed working
# below.
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.local/state/terminal-mcp

# A plain per-process prctl flag, no capability drop or new namespace
# required -- confirmed working here (see below for why that distinction
# matters on this particular host).
NoNewPrivileges=yes

# Seccomp syscall allowlist -- systemd's own curated, broad "typical
# network service that also spawns subprocesses" profile (this service's
# real shape: uvicorn's networking, sqlite's file I/O, and tmux spawned
# via subprocess.run for every observe/control call). A conservative
# ALLOWlist (default-deny outside the group), not a hand-picked narrow
# one -- deliberately preferred over enumerating individual syscalls,
# which risks silently missing one this project's own dependencies need.
# Live-verified on a disposable staging instance (isolated port/state
# dir/systemd unit, same binary) before being adopted here: clean start,
# zero seccomp/journal denials, and a full functional pass -- tmux list/
# tail/status/capture, a real guarded terminal_send_text AND
# terminal_send_bound, bind/unbind, a full supervisor_watch -> run_once
# poll cycle producing a real sqlite-persisted event, and the dashboard
# routes -- all against the actual sandboxed process, not assumed safe.
SystemCallFilter=@system-service

# --- Deliberately NOT included, and why -----------------------------------
# This host's systemd --user instance cannot create the mount/user
# namespaces most Protect*=/Restrict*=/LockPersonality= directives need
# (confirmed precisely, not guessed: `apparmor_restrict_unprivileged_
# userns` is enabled system-wide here -- `unshare --mount` fails with
# "Operation not permitted" for this user even outside systemd entirely).
# CapabilityBoundingSet=, ProtectKernelTunables=, ProtectKernelModules=,
# ProtectControlGroups=, ProtectClock=, ProtectHostname=, RestrictSUIDSGID=,
# RestrictNamespaces=, LockPersonality= were each tested live against this
# exact unit and failed identically:
#   "Failed to drop capabilities: Operation not permitted"
#   "Failed at step CAPABILITIES spawning ...: Operation not permitted"
# systemd.exec(5) documents that most of them implicitly restrict the
# capability bounding set as part of their enforcement (not only the ones
# that look capability-related by name), which is what actually fails
# here -- this is an AppArmor policy restricting unprivileged namespace
# creation, not a capability/seccomp restriction, which is exactly why
# SystemCallFilter= above (seccomp via NNP, no new namespace needed) works
# fine even though those others don't. If your host does not set
# apparmor_restrict_unprivileged_userns (check `cat /proc/sys/kernel/
# apparmor_restrict_unprivileged_userns`) or runs systemd --system (root)
# rather than --user, the directives above are very likely safe to add --
# test one at a time with `systemctl restart` + `journalctl -u
# terminal-mcp-http -n 20`, watching specifically for "Failed to drop
# capabilities", and keep only what starts cleanly and passes
# /health/ready afterward.
#
#   PrivateTmp=yes        -- would cut off the real tmux socket regardless
#                             of the capability/namespace question above.
#   MemoryDenyWriteExecute=yes -- some cryptography (PyJWT[crypto]) code
#                             paths can need W+X pages for accelerated
#                             implementations; not worth the risk of a
#                             subtle, intermittent crash for this pass.
# ----------------------------------------------------------------------

[Install]
WantedBy=default.target
