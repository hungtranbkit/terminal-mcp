# ~/.config/terminal-mcp/tunnel-guard.env on a FALLBACK controller host.
# The canonical controller whose tunnel-client owns the OpenAI tunnel id.
# Required: the guard refuses to let the fallback join without it.
TERMINAL_MCP_PRIMARY_HOST=100.67.53.117
TERMINAL_MCP_PRIMARY_PORT=8766
# Only units whose tunnel the primary ALSO serves.
TERMINAL_MCP_GUARD_UNITS="terminal-mcp-tunnel.service"
