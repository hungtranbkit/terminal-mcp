{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agents Deck read-only Device API v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "running", "total", "page", "next_page", "items"],
  "properties": {
    "version": {"const": 1},
    "running": {"type": "integer", "minimum": 0, "maximum": 120},
    "total": {"type": "integer", "minimum": 0, "maximum": 120},
    "page": {"type": "integer", "minimum": 0, "maximum": 1000},
    "next_page": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000},
    "items": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "machine", "session", "status", "age_s"],
        "properties": {
          "id": {"$ref": "#/$defs/label"},
          "machine": {"$ref": "#/$defs/label"},
          "session": {"$ref": "#/$defs/label"},
          "status": {"enum": ["working", "pending", "waiting", "done", "blocked", "failed", "cancelled", "stale", "unknown"]},
          "age_s": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    }
  },
  "$defs": {"label": {"type": "string", "pattern": "^[A-Za-z0-9 _.-]{1,24}$"}}
}
