#!/usr/bin/env python3
"""Print the sanitized tail excerpt from the last poll, or recent state-change history."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

DEFAULT_STATE_DIR = Path.home() / ".projectflow-watch"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--history", action="store_true",
                         help="Show state-transition history instead of the last tail excerpt.")
    parser.add_argument("-n", "--lines", type=int, default=20,
                         help="With --history, how many recent transitions to show (default: 20).")
    parser.add_argument("--state-dir", type=Path, default=DEFAULT_STATE_DIR)
    args = parser.parse_args()

    if args.history:
        history_path = args.state_dir / "history.log"
        if not history_path.exists():
            print(f"No history file at {history_path} yet — no state transitions recorded.",
                  file=sys.stderr)
            return 1
        lines = history_path.read_text(encoding="utf-8").splitlines()
        for line in lines[-args.lines:]:
            print(line)
        return 0

    status_path = args.state_dir / "status.json"
    if not status_path.exists():
        print(f"No status file at {status_path} yet — has the timer run at least once?"
              f" Try: systemctl --user start projectflow-watch.service", file=sys.stderr)
        return 1
    data = json.loads(status_path.read_text(encoding="utf-8"))
    print(data.get("tail_excerpt", ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
