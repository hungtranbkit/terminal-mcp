# Python environments and generated files
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Local configuration and credentials
.env
*.env
!.env.example
!*.env.example
tunnel.env
# Generated by deploy/install-node-agent.ps1 -- carries this node's own
# bearer token inline (Windows has no separate EnvironmentFile= the way
# the Linux install-node-agent.sh's node-agent.env, already covered by
# *.env above, gets).
run-node-agent.ps1
*tunnel*credential*
*credentials*.json
*.pem
*.key

# Runtime state, databases, and logs
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.log
run/
runtime/
state/
# Local runtime state for this repo's own node-agent/backlog dir.
# NOTE: the directory contents are ignored, NOT the directory itself --
# git cannot re-include a file whose PARENT directory is excluded, so
# `.terminal-mcp/*` + a negation is the only shape that lets the Project
# Backlog be tracked while the lock/state files stay local.
.terminal-mcp/*
# The backlog IS the project's plan -- tracked on purpose so it survives a
# clone and reaches other nodes (see docs/backlog.md, "Tracked vs ignored").
!.terminal-mcp/backlog.json

# Editor and OS-local files
.DS_Store
.idea/
.vscode/
*.swp
